package org.fossify.gallery.helpers

import android.media.MediaDataSource
import java.io.File
import java.io.RandomAccessFile
import javax.crypto.Cipher
import javax.crypto.spec.IvParameterSpec
import javax.crypto.spec.SecretKeySpec

/**
 * 小米私密相册 (.lsa / .lsav / .sa / .sav) 解密与扫描模块
 * 适用于开源相册 Fossify Gallery (https://github.com/FossifyOrg/Gallery)
 * 制作: 酷安企年制作
 */
object XiaomiSecretDecoder {

    // 默认 MIUI / HyperOS 官方签名密钥与底层 IV (16 字节)
    private const val DEFAULT_KEY_HEX = "3082046c30820354a003020102020900"
    private const val DEFAULT_IV_HEX = "11132123313341435153616667687172"
    private const val VIDEO_ENCRYPTED_HEADER_SIZE = 1024

    private val SECRET_EXTENSIONS = setOf("lsa", "lsav", "sa", "sav")

    data class SecretMediaItem(
        val file: File,
        val isVideo: Boolean,
        val mimeType: String
    )

    fun isSecretFile(file: File): Boolean {
        return file.isFile && file.extension.lowercase() in SECRET_EXTENSIONS
    }

    /**
     * 扫描指定目录（如 /storage/emulated/0/MIUI/Gallery/cloud/secretAlbum）下的小米私密文件
     */
    fun scanSecretDirectory(rootDir: File): List<SecretMediaItem> {
        if (!rootDir.exists() || !rootDir.isDirectory) return emptyList()
        return rootDir.walkTopDown()
            .filter { isSecretFile(it) }
            .map { file ->
                val ext = file.extension.lowercase()
                val isVideo = ext == "lsav" || ext == "sav"
                SecretMediaItem(
                    file = file,
                    isVideo = isVideo,
                    mimeType = if (isVideo) "video/mp4" else "image/jpeg"
                )
            }
            .toList()
    }

    /**
     * 解密私密照片 (.lsa / .sa) 为明文字节数组，可直接交给 Glide / BitmapFactory 渲染
     */
    fun decryptPhotoBytes(
        encryptedFile: File,
        keyHex: String = DEFAULT_KEY_HEX,
        ivHex: String = DEFAULT_IV_HEX
    ): ByteArray {
        val cipherBytes = encryptedFile.readBytes()
        return aesCtrTransform(cipherBytes, hexToBytes(keyHex), hexToBytes(ivHex))
    }

    /**
     * 解密私密视频 (.lsav / .sav) 头部 1024 字节，返回可直接用于 ExoPlayer / MediaPlayer 的流式数据源
     * 无需将完整明文视频写入磁盘，兼顾性能与隐私
     */
    fun createVideoDataSource(
        encryptedFile: File,
        keyHex: String = DEFAULT_KEY_HEX,
        ivHex: String = DEFAULT_IV_HEX
    ): MediaDataSource {
        val headerSize = minOf(VIDEO_ENCRYPTED_HEADER_SIZE, encryptedFile.length().toInt())
        val encryptedHeader = ByteArray(headerSize)
        RandomAccessFile(encryptedFile, "r").use { raf ->
            raf.readFully(encryptedHeader)
        }
        val decryptedHeader = aesCtrTransform(encryptedHeader, hexToBytes(keyHex), hexToBytes(ivHex))
        return XiaomiSecretVideoDataSource(encryptedFile, decryptedHeader)
    }

    /**
     * 导出明文文件到指定目标路径
     */
    fun exportDecryptedFile(
        sourceFile: File,
        destFile: File,
        keyHex: String = DEFAULT_KEY_HEX,
        ivHex: String = DEFAULT_IV_HEX
    ) {
        val ext = sourceFile.extension.lowercase()
        if (ext == "lsav" || ext == "sav") {
            val totalLen = sourceFile.length()
            val headerSize = minOf(VIDEO_ENCRYPTED_HEADER_SIZE.toLong(), totalLen).toInt()
            val encHeader = ByteArray(headerSize)
            RandomAccessFile(sourceFile, "r").use { raf ->
                raf.readFully(encHeader)
                val decHeader = aesCtrTransform(encHeader, hexToBytes(keyHex), hexToBytes(ivHex))
                destFile.outputStream().use { out ->
                    out.write(decHeader)
                    val buffer = ByteArray(8192)
                    var read: Int
                    while (raf.read(buffer).also { read = it } != -1) {
                        out.write(buffer, 0, read)
                    }
                }
            }
        } else {
            destFile.writeBytes(decryptPhotoBytes(sourceFile, keyHex, ivHex))
        }
    }

    private fun aesCtrTransform(data: ByteArray, key: ByteArray, iv: ByteArray): ByteArray {
        val cipher = Cipher.getInstance("AES/CTR/NoPadding")
        cipher.init(Cipher.DECRYPT_MODE, SecretKeySpec(key, "AES"), IvParameterSpec(iv))
        return cipher.doFinal(data)
    }

    private fun hexToBytes(hex: String): ByteArray {
        val clean = hex.replace(Regex("[^0-9a-fA-F]"), "")
        return ByteArray(clean.length / 2) { i ->
            clean.substring(i * 2, i * 2 + 2).toInt(16).toByte()
        }
    }

    private class XiaomiSecretVideoDataSource(
        private val file: File,
        private val decryptedHeader: ByteArray
    ) : MediaDataSource() {

        private val raf = RandomAccessFile(file, "r")

        override fun readAt(position: Long, buffer: ByteArray, offset: Int, size: Int): Int {
            val totalSize = file.length()
            if (position >= totalSize) return -1
            val available = minOf(size.toLong(), totalSize - position).toInt()
            var copied = 0

            if (position < decryptedHeader.size) {
                val headerCopy = minOf(available, decryptedHeader.size - position.toInt())
                System.arraycopy(decryptedHeader, position.toInt(), buffer, offset, headerCopy)
                copied += headerCopy
            }

            if (copied < available) {
                raf.seek(position + copied)
                val read = raf.read(buffer, offset + copied, available - copied)
                if (read > 0) copied += read
            }
            return copied
        }

        override fun getSize(): Long = file.length()

        override fun close() {
            raf.close()
        }
    }
}
